# Backend adresi (ör. https://api.halisaha.example). Geliştirmede boş bırak: Vite /api isteklerini localhost:8000'e yönlendirir.
# Auth token (Bearer) ile yapıldığı için frontend ve backend farklı alan adlarında olabilir; backend'de CORS_ALLOWED_ORIGINS ayarlanmalı.
VITE_API_URL=

# true: Laravel olmadan sahte (mock) veriyle çalışır.
# Backend hazır olunca false yap.
VITE_USE_MOCK=true
